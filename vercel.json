{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "build": {
    "env": {
      "SITE_URL": "https://webcross.ai",
      "NEXT_PUBLIC_SITE_URL": "https://webcross.ai"
    }
  },
  "env": {
    "SITE_URL": "https://webcross.ai",
    "NEXT_PUBLIC_SITE_URL": "https://webcross.ai"
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.webcross.ai" }],
      "destination": "https://webcross.ai/:path*",
      "permanent": true
    }
  ]
}
